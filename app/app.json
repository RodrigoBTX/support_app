{
  "expo": {
    "name": "Gestão de Suporte",
    "slug": "suporte-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f5f9ff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.empresa.suporteapp",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "pt.empresa.suporteapp",
      "permissions": ["CAMERA"],
      "usesCleartextTraffic": true
    },
    "plugins": ["expo-secure-store"]
  }
}
