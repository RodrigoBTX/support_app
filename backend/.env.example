# Copiar para ".env" e preencher com os dados reais desta instalação.
# Este ficheiro é gerado/preenchido pelo instalador — não deve ser commitado com dados reais.

# --- API ---
API_PORT=4000
API_JWT_SECRET=alterar_para_um_segredo_aleatorio_longo
# Deixar vazio = sessão sem expiração (decisão do projeto). Só preencher (ex: "7d")
# se um dia quiseres passar a forçar expiração de sessão.
API_JWT_EXPIRES_IN=

# --- SQL Server ---
SQL_SERVER=SRV-SQL01
SQL_INSTANCE=SUPORTE
SQL_PORT=1433
SQL_DATABASE=GestaoSuporte
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# --- Armazenamento de fotos / assinaturas ---
UPLOADS_PATH=./uploads

# --- Backoffice ---
BACKOFFICE_PASSWORD=alterar_esta_password

# --- Logs ---
LOG_RETENTION_DAYS=90
